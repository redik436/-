-- Прокрутка автоматически увеличивается вместе со списком.
local function scrollingFrame(parent, name)
    local frame = create("ScrollingFrame", {
        Name = name,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        CanvasSize = UDim2.fromOffset(0, 0),
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = themes[themeIndex].color,
        Active = true,
        ClipsDescendants = true,
    }, parent)

    create("UIPadding", {
        PaddingTop = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 6),
    }, frame)

    local layout = create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6),
    }, frame)

    local function syncCanvas()
        frame.CanvasSize = UDim2.fromOffset(
            0,
            layout.AbsoluteContentSize.Y + 8
        )
    end

    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), syncCanvas)
    connect(frame:GetPropertyChangedSignal("AbsoluteSize"), syncCanvas)
    syncCanvas()
    return frame
end

