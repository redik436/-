local function updateTheme()
    local theme = themes[themeIndex]
    border.Color = theme.color
    logo.BackgroundColor3 = theme.color
    launcher.BackgroundColor3 = theme.color
    launcher.TextColor3 = colors.background
    themeButton.Text = "Акцент: " .. theme.name
    themeButton.TextColor3 = theme.color
    tabList.ScrollBarImageColor3 = theme.color

    for _, tab in ipairs(tabs) do
        tab.page.ScrollBarImageColor3 = theme.color
    end

    selectTab(activeTab)
end

local function updateScrollHint()
    local overflow = tabList.CanvasSize.Y.Offset - tabList.AbsoluteSize.Y
    if overflow > 1 then
        scrollHint.Text = tabList.CanvasPosition.Y >= overflow - 1
            and "Листай вверх ↑"
            or "Прокрутка ↓"
    else
        scrollHint.Text = "Разделов: " .. #tabs
    end
end

local function moveWindow(position)
    local viewport = canvas.AbsoluteSize
    if viewport.X <= 0 or viewport.Y <= 0 then return end

    local margin = math.min(12, viewport.X / 4, viewport.Y / 4)
    window.Position = UDim2.fromOffset(
        clamp(position.X, margin,
            math.max(margin, viewport.X - window.Size.X.Offset - margin)),
        clamp(position.Y, margin,
            math.max(margin, viewport.Y - window.Size.Y.Offset - margin))
    )
end

local function resizeMenu()
    local viewport = canvas.AbsoluteSize
    if not gui.Parent or viewport.X <= 0 or viewport.Y <= 0 then return end

    dragInput = nil
    local margin = math.min(12, viewport.X / 4, viewport.Y / 4)
    local width = math.min(660, viewport.X - margin * 2)
    local fullHeight = math.min(430, viewport.Y - margin * 2)
    local height = collapsed and math.min(60, fullHeight) or fullHeight
    window.Size = UDim2.fromOffset(width, height)

    local bodyWidth = math.max(0, width - 28)
    local bodyHeight = math.max(0, fullHeight - 88)
    local sideWidth = math.min(
        clamp(math.floor(bodyWidth * 0.28), 120, 170),
        math.max(0, bodyWidth - 90)
    )
    local left = math.min(bodyWidth, sideWidth + 12)

    body.Size = UDim2.fromOffset(bodyWidth, bodyHeight)
    body.Visible = not collapsed and bodyHeight >= 52
    sidebar.Size = UDim2.fromOffset(sideWidth, bodyHeight)
    content.Position = UDim2.fromOffset(left, 0)
    content.Size = UDim2.fromOffset(math.max(0, bodyWidth - left), bodyHeight)

    local short = bodyHeight < 140
    local top = short and 8 or 40
    local bottom = short and 8 or 32
    navigationTitle.Visible = not short
    scrollHint.Visible = not short

    tabList.Position = UDim2.fromOffset(8, top)
    tabList.Size = UDim2.fromOffset(
        math.max(0, sideWidth - 16),
        math.max(0, bodyHeight - top - bottom)
    )

    pageHost.Size = UDim2.new(1, 0, 0, math.max(0, bodyHeight - 40))
    title.Size = UDim2.fromOffset(math.max(0, width - 158), 24)
    subtitle.Size = UDim2.fromOffset(math.max(0, width - 158), 16)
    launcher.Position = UDim2.new(0, margin, 1, -margin)
    launcher.Size = UDim2.fromOffset(
        math.min(150, viewport.X - margin * 2),
        math.min(38, viewport.Y - margin * 2)
    )

    if not positioned then
        positioned = true
        moveWindow(Vector2.new(
            (viewport.X - width) / 2,
            (viewport.Y - height) / 2
        ))
    else
        moveWindow(Vector2.new(
            window.Position.X.Offset,
            window.Position.Y.Offset
        ))
    end

    updateScrollHint()
end

local function setOpen(open)
    dragInput = nil
    window.Visible = open
    launcher.Visible = not open
end

connect(themeButton.Activated, function()
    themeIndex = themeIndex % #themes + 1
    updateTheme()
end)

connect(minimize.Activated, function()
    collapsed = not collapsed
    minimize.Text = collapsed and "+" or "−"
    resizeMenu()
end)

connect(close.Activated, function()
    setOpen(false)
end)

connect(launcher.Activated, function()
    setOpen(true)
end)

connect(UserInputService.InputBegan, function(input, processed)
    if not processed
        and input.KeyCode == Enum.KeyCode.RightShift
        and not UserInputService:GetFocusedTextBox() then
        setOpen(not window.Visible)
    end
end)

connect(dragHandle.InputBegan, function(input)
    if not dragInput and window.Visible and
        (input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch) then
        dragInput = input
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        windowStart = Vector2.new(
            window.Position.X.Offset,
            window.Position.Y.Offset
        )
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not dragInput or not window.Visible then return end

    if dragInput.UserInputType == Enum.UserInputType.MouseButton1 then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
    elseif input ~= dragInput then
        return
    end

    moveWindow(
        windowStart + Vector2.new(input.Position.X, input.Position.Y) - dragStart
    )
end)

connect(UserInputService.InputEnded, function(input)
    if dragInput and
        (input == dragInput or
        (input.UserInputType == Enum.UserInputType.MouseButton1
        and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
        dragInput = nil
    end
end)

connect(UserInputService.WindowFocusReleased, function()
    dragInput = nil
end)

connect(canvas:GetPropertyChangedSignal("AbsoluteSize"), resizeMenu)
connect(tabList:GetPropertyChangedSignal("CanvasSize"), updateScrollHint)
connect(tabList:GetPropertyChangedSignal("AbsoluteSize"), updateScrollHint)
connect(tabList:GetPropertyChangedSignal("CanvasPosition"), updateScrollHint)

updateTheme()
