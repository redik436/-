local function selectTab(name)
    activeTab = name
    local accent = themes[themeIndex].color
    for tabName, page in pairs(pages) do
        local selected = tabName == name
        page.Visible = selected
        tabButtons[tabName].BackgroundColor3 = selected and accent or colors.button
        tabButtons[tabName].TextColor3 = selected and colors.background or colors.text
    end
end

local function updateTheme()
    local theme = themes[themeIndex]
    border.Color = theme.color
    launcher.BackgroundColor3 = theme.color
    launcher.TextColor3 = colors.background
    themeButton.Text = "Акцент: " .. theme.name
    themeButton.TextColor3 = theme.color
    selectTab(activeTab)
end

local function moveWindow(position)
    local viewport = canvas.AbsoluteSize
    if viewport.X <= 0 or viewport.Y <= 0 then
        return
    end
    local margin = math.min(12, viewport.X / 4, viewport.Y / 4)
    local maxX = math.max(margin, viewport.X - window.Size.X.Offset - margin)
    local maxY = math.max(margin, viewport.Y - window.Size.Y.Offset - margin)
    window.Position = UDim2.fromOffset(
        math.clamp(position.X, margin, maxX),
        math.clamp(position.Y, margin, maxY)
    )
end

local function resizeMenu()
    local viewport = canvas.AbsoluteSize
    if viewport.X <= 0 or viewport.Y <= 0 then
        return
    end
    local margin = math.min(12, viewport.X / 4, viewport.Y / 4)
    local width = math.min(560, viewport.X - margin * 2)
    local height = math.min(390, viewport.Y - margin * 2)
    window.Size = UDim2.fromOffset(width, collapsed and math.min(54, height) or height)

    if not positioned then
        positioned = true
        moveWindow(Vector2.new((viewport.X - width) / 2, (viewport.Y - height) / 2))
    else
        moveWindow(Vector2.new(window.Position.X.Offset, window.Position.Y.Offset))
    end
end

local function setOpen(open)
    draggingInput = nil
    window.Visible = open
    launcher.Visible = not open
end

for _, name in ipairs(tabNames) do
