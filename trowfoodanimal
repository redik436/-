connect(UserInputService.InputBegan, function(input, processed)
    if not processed and input.KeyCode == Enum.KeyCode.RightShift and not UserInputService:GetFocusedTextBox() then
        setOpen(not window.Visible)
    end
end)

connect(dragHandle.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingInput = input
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        windowStart = Vector2.new(window.Position.X.Offset, window.Position.Y.Offset)
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not draggingInput or not window.Visible then
        return
    end
    if draggingInput.UserInputType == Enum.UserInputType.MouseButton1 then
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
    elseif input ~= draggingInput then
        return
    end
    local position = Vector2.new(input.Position.X, input.Position.Y)
    moveWindow(windowStart + position - dragStart)
end)

connect(UserInputService.InputEnded, function(input)
    if not draggingInput then
        return
    end
    if input == draggingInput or (input.UserInputType == Enum.UserInputType.MouseButton1 and draggingInput.UserInputType == Enum.UserInputType.MouseButton1) then
        draggingInput = nil
    end
end)

connect(canvas:GetPropertyChangedSignal("AbsoluteSize"), resizeMenu)
updateTheme()
resizeMenu()

