local function selectTab(name)
    if not pages[name] then return end

    activeTab = name
    pageTitle.Text = name
    local accent = themes[themeIndex].color

    for _, tab in ipairs(tabs) do
        local selected = tab.name == name
        tab.page.Visible = selected
        tab.button.BackgroundColor3 = selected
            and accent:Lerp(colors.sidebar, 0.8)
            or colors.button
        tab.title.TextColor3 = selected and colors.text or colors.muted
        tab.indicator.BackgroundColor3 = accent
        tab.indicator.Visible = selected
    end
end

local function addTab(name)
    if pages[name] then return pages[name] end

    local tabButton = button(tabList, "")
    tabButton.Name = name
    tabButton.Size = UDim2.new(1, 0, 0, 42)
    tabButton.LayoutOrder = #tabs + 1

    local tabTitle = label(tabButton, name, 13)
    tabTitle.Font = Enum.Font.GothamMedium
    tabTitle.Position = UDim2.fromOffset(12, 0)
    tabTitle.Size = UDim2.new(1, -24, 1, 0)

    local indicator = create("Frame", {
        BackgroundColor3 = themes[themeIndex].color,
        BorderSizePixel = 0,
        Position = UDim2.fromOffset(0, 12),
        Size = UDim2.fromOffset(3, 18),
        Visible = false,
    }, tabButton)
    round(indicator, 2)

    local page = scrollingFrame(pageHost, name)
    page.Visible = false
    pages[name] = page

    table.insert(tabs, {
        name = name,
        button = tabButton,
        title = tabTitle,
        indicator = indicator,
        page = page,
    })

    connect(tabButton.Activated, function()
        selectTab(name)
    end)

    return page
end

local function card(page, heading, description, order)
    local frame = create("Frame", {
        BackgroundColor3 = colors.card,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = order,
    }, page)
    round(frame, 12)
    stroke(frame, colors.outline)

    create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
    }, frame)

    create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 8),
    }, frame)

    for index, text in ipairs({ heading, description }) do
        local item = label(
            frame,
            text,
            index == 1 and 16 or 13,
            index == 1 and colors.text or colors.muted
        )
        item.Font = index == 1 and Enum.Font.GothamBold or Enum.Font.Gotham
        item.Size = UDim2.new(1, 0, 0, 0)
        item.AutomaticSize = Enum.AutomaticSize.Y
        item.LayoutOrder = index
        item.TextWrapped = true
        item.TextTruncate = Enum.TextTruncate.None
        item.TextYAlignment = Enum.TextYAlignment.Top
    end

    return frame
end

