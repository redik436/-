-- Main: настройки локального персонажа.
do
    local RunService = game:GetService("RunService")
    local mainPage = addTab("Main")
    activeTab = "Main"

    local alive, noclipEnabled = true, false
    local noclipConnection, waitingConnection, boundCharacter
    local partStates, humanoidStates = {}, {}
    local speedOverride, heightOverride

    local function getHumanoid()
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            return humanoid
        end
    end

    local function displayNumber(value)
        return (string.format("%.2f", value):gsub("0+$", ""):gsub("%.$", ""))
    end

    local function restoreParts()
        for part, canCollide in pairs(partStates) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end
        partStates = {}
    end

    local function restoreMovement()
        for humanoid, original in pairs(humanoidStates) do
            if humanoid.Parent then
                if original.speed ~= nil then
                    humanoid.WalkSpeed = original.speed
                end
                if original.height ~= nil then
                    humanoid.JumpHeight = original.height
                    humanoid.UseJumpPower = original.useJumpPower
                end
            end
        end
        humanoidStates = {}
    end

    local function applyMovement(humanoid)
        if not humanoid or humanoid.Health <= 0 then
            return false
        end
        if speedOverride == nil and heightOverride == nil then
            return true
        end

        local original = humanoidStates[humanoid] or {}
        humanoidStates[humanoid] = original

        if speedOverride ~= nil then
            if original.speed == nil then
                original.speed = humanoid.WalkSpeed
            end
            humanoid.WalkSpeed = speedOverride
        end

        if heightOverride ~= nil then
            if original.height == nil then
                original.height = humanoid.JumpHeight
                original.useJumpPower = humanoid.UseJumpPower
            end
            humanoid.UseJumpPower = false
            humanoid.JumpHeight = heightOverride
        end
        return true
    end

    local function stopWaiting()
        if waitingConnection then
            waitingConnection:Disconnect()
            waitingConnection = nil
        end
    end

    local function stepNoclip()
        local character = player.Character
        if not alive or not noclipEnabled or not character or not getHumanoid() then
            restoreParts()
            return
        end

        for part, canCollide in pairs(partStates) do
            if not part:IsDescendantOf(character) then
                if part.Parent then
                    part.CanCollide = canCollide
                end
                partStates[part] = nil
            end
        end

        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if partStates[part] == nil then
                    partStates[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    end

    local noclipCard = card(mainPage, "Ноклип",
        "Отключает коллизии персонажа, включая пол. Включай осторожно.", 1)

    local noclipButton = button(noclipCard, "Ноклип: выключен")
    noclipButton.Name = "Noclip"
    noclipButton.Size = UDim2.new(1, 0, 0, 38)
    noclipButton.LayoutOrder = 3
    noclipButton.TextColor3 = colors.muted
    noclipButton.TextSize = 13
    noclipButton.TextWrapped = true

    local speedCard = card(mainPage, "Скорость ходьбы",
        "От 0 до 200. Enter или ✓ — применить.", 2)

    local heightCard = card(mainPage, "Высота прыжка",
        "От 0 до 100 studs. Enter или ✓ — применить.", 3)

    local status = label(mainPage,
        "Настройки действуют локально; сервер игры может их ограничивать.",
        12, colors.muted)
    status.Name = "MovementStatus"
    status.Size = UDim2.new(1, 0, 0, 0)
    status.AutomaticSize = Enum.AutomaticSize.Y
    status.TextWrapped = true
    status.TextTruncate = Enum.TextTruncate.None
    status.LayoutOrder = 4

    local resetButton = button(mainPage, "Сбросить настройки")
    resetButton.Name = "ResetMovement"
    resetButton.Size = UDim2.new(1, 0, 0, 38)
    resetButton.LayoutOrder = 5
    resetButton.TextSize = 13
    resetButton.TextWrapped = true

    local function setStatus(text, errorState)
        if not alive then return end
        status.Text = text
        status.TextColor3 = errorState
            and Color3.fromRGB(255, 140, 157)
            or colors.muted
    end

    local function inputRow(parent, name, initialValue)
        local row = create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 38),
            LayoutOrder = 3,
        }, parent)

        local box = create("TextBox", {
            Name = name,
            BackgroundColor3 = colors.background,
            BorderSizePixel = 0,
            Size = UDim2.new(1, -44, 1, 0),
            Font = Enum.Font.GothamMedium,
            Text = displayNumber(initialValue),
            TextSize = 14,
            TextColor3 = colors.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            MultiLine = false,
            PlaceholderText = "Число",
        }, row)
        round(box, 8)
        stroke(box, colors.outline)

        create("UIPadding", {
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 4),
        }, box)

        local applyButton = button(row, "✓")
        applyButton.Name = "Apply" .. name
        applyButton.AnchorPoint = Vector2.new(1, 0.5)
        applyButton.Position = UDim2.new(1, 0, 0.5, 0)
        applyButton.Size = UDim2.fromOffset(36, 36)

        return box, applyButton
    end

    local humanoid = getHumanoid()
    local speedBox, applySpeed = inputRow(
        speedCard, "WalkSpeed", humanoid and humanoid.WalkSpeed or 16
    )
    local heightBox, applyHeight = inputRow(
        heightCard, "JumpHeight", humanoid and humanoid.JumpHeight or 7.2
    )

    local function setNoclip(enabled)
        if not alive then return end
        noclipEnabled = enabled

        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end

        if enabled then
            noclipConnection = RunService.Stepped:Connect(stepNoclip)
            stepNoclip()
        else
            restoreParts()
        end

        noclipButton.Text = enabled
            and "Ноклип: включён"
            or "Ноклип: выключен"
        noclipButton.TextColor3 = enabled
            and Color3.fromRGB(103, 217, 170)
            or colors.muted
    end

    local function commitInput(box, maximum, kind, title)
        if not alive then return end

        local text = box.Text:gsub(",", ".")
        local value = tonumber(text)

        if not value or value ~= value or value < 0 or value > maximum then
            setStatus(title .. ": введи число от 0 до " .. maximum .. ".", true)
            return
        end

        value = math.floor(value * 100 + 0.5) / 100
        box.Text = displayNumber(value)

        if kind == "speed" then
            speedOverride = value
        else
            heightOverride = value
        end

        if applyMovement(getHumanoid()) then
            setStatus(title .. ": " .. box.Text .. ".")
        else
            setStatus("Значение сохранено и применится после появления персонажа.")
        end
    end

    local function commitSpeed()
        commitInput(speedBox, 200, "speed", "Скорость")
    end

    local function commitHeight()
        commitInput(heightBox, 100, "height", "Высота прыжка")
    end

    connect(applySpeed.Activated, commitSpeed)
    connect(applyHeight.Activated, commitHeight)

    connect(speedBox.FocusLost, function(enterPressed)
        if enterPressed then commitSpeed() end
    end)

    connect(heightBox.FocusLost, function(enterPressed)
        if enterPressed then commitHeight() end
    end)

    connect(noclipButton.Activated, function()
        setNoclip(not noclipEnabled)
        setStatus(noclipEnabled
            and "Ноклип включён: коллизии, в том числе с полом, отключены."
            or "Ноклип выключен.")
    end)

    connect(resetButton.Activated, function()
        speedOverride, heightOverride = nil, nil
        setNoclip(false)
        restoreMovement()

        local current = getHumanoid()
        speedBox.Text = displayNumber(current and current.WalkSpeed or 16)
        heightBox.Text = displayNumber(current and current.JumpHeight or 7.2)
        setStatus("Исходные настройки персонажа восстановлены.")
    end)

    local function bindCharacter(character)
        if not alive then return end
        stopWaiting()
        restoreParts()
        restoreMovement()
        boundCharacter = character

        if not character then return end

        local function ready(current)
            if not alive or player.Character ~= character then return end
            applyMovement(current)

            if speedOverride == nil then
                speedBox.Text = displayNumber(current.WalkSpeed)
            end
            if heightOverride == nil then
                heightBox.Text = displayNumber(current.JumpHeight)
            end
        end

        local current = character:FindFirstChildOfClass("Humanoid")
        if current then
            ready(current)
        else
            waitingConnection = character.ChildAdded:Connect(function(child)
                if child:IsA("Humanoid") then
                    stopWaiting()
                    ready(child)
                end
            end)
        end
    end

    connect(player.CharacterAdded, bindCharacter)

    connect(player.CharacterRemoving, function(character)
        if character == boundCharacter then
            stopWaiting()
            restoreParts()
            restoreMovement()
            boundCharacter = nil
        end
    end)

    -- Восстановление при удалении или повторном запуске меню.
    gui.Destroying:Connect(function()
        alive, noclipEnabled = false, false
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        stopWaiting()
        restoreParts()
        restoreMovement()
    end)

    bindCharacter(player.Character)
end

local homePage = addTab("Главная")
local settingsPage = addTab("Настройки")
local aboutPage = addTab("О меню")

card(homePage, "Добро пожаловать",
    "Выбирай раздел слева. Когда кнопок станет много, список можно листать вниз колёсиком мыши или свайпом.", 1)

card(homePage, "Управление",
    "Перетаскивай окно за верхнюю панель.\n«−» — свернуть, «×» — скрыть.\nRight Shift — скрыть или показать меню.", 2)

local appearanceCard = card(settingsPage, "Оформление",
    "Нажимай кнопку ниже, чтобы менять цвет меню.", 1)

local themeButton = button(appearanceCard, "")
themeButton.Name = "ChangeTheme"
themeButton.Size = UDim2.new(1, 0, 0, 38)
themeButton.LayoutOrder = 3

card(aboutPage, "RB Menu",
    "Клиентское меню с настройками локального персонажа. Сервер игры может ограничивать скорость, прыжок и ноклип. Без сторонних библиотек.", 1)

