		return nil, nil
	end
	return character, root
end

connect(saveButton.Activated, function()
	local character = getCharacter()
	if not character then
		return
	end
	savedPivot = character:GetPivot()
	local position = savedPivot.Position
	pointLabel.Text = string.format("X: %.0f   Y: %.0f   Z: %.0f", position.X, position.Y, position.Z)
	setStatus("Точка сохранена на время работы меню.")
end)

connect(teleportButton.Activated, function()
	if not savedPivot then
		setStatus("Сначала сохрани текущую позицию.", true)
		return
	end
	local character, root = getCharacter()
	if not character then
		return
	end
	local ok, err = pcall(function()
		character:PivotTo(savedPivot)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	if not ok then
		setStatus("Не удалось переместить персонажа.", true)
		warn("99 Nights Menu TP: " .. tostring(err))
		return
	end
	setStatus("Позиция изменена локально. Сервер может откатить TP.")
end)

local function selectTab(tab)
	local creditsSelected = tab == "Credits"
	creditsPage.Visible = creditsSelected
	tpPage.Visible = not creditsSelected
	creditsTab.BackgroundColor3 = creditsSelected and colors.accent or colors.button
	creditsTab.TextColor3 = creditsSelected and colors.background or colors.text
	tpTab.BackgroundColor3 = creditsSelected and colors.button or colors.accent
	tpTab.TextColor3 = creditsSelected and colors.text or colors.background
	setStatus(creditsSelected and "M — скрыть/показать меню." or "TP локальный: сервер может вернуть персонажа назад.")
end

connect(creditsTab.Activated, function()
	selectTab("Credits")
end)
connect(tpTab.Activated, function()
	selectTab("TP")
end)

local dragPointer
local dragStart
local windowStart

local function setVisible(visible)
	window.Visible = visible
	openButton.Visible = not visible
	dragPointer = nil
end

connect(hideButton.Activated, function()
	setVisible(false)
end)
connect(openButton.Activated, function()
	setVisible(true)
end)
connect(UserInputService.InputBegan, function(input, processed)
	if not processed and not UserInputService:GetFocusedTextBox() and input.KeyCode == Enum.KeyCode.M then
		setVisible(not window.Visible)
	end
end)

connect(header.InputBegan, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragPointer = input
		dragStart = input.Position
		windowStart = window.AbsolutePosition
	end
end)

connect(UserInputService.InputChanged, function(input)
	if not dragPointer or not window.Visible then
		return
	end
	local mouseMoving = dragPointer.UserInputType == Enum.UserInputType.MouseButton1
		and input.UserInputType == Enum.UserInputType.MouseMovement
	if not mouseMoving and input ~= dragPointer then
		return
	end
	local delta = input.Position - dragStart
	local viewport = viewportSize()
	local size = window.AbsoluteSize
	local x = math.clamp(windowStart.X + delta.X, 0, math.max(0, viewport.X - size.X))
	local y = math.clamp(windowStart.Y + delta.Y, 0, math.max(0, viewport.Y - size.Y))
	window.Position = UDim2.fromOffset(x, y)
end)

connect(UserInputService.InputEnded, function(input)
	if input == dragPointer then
		dragPointer = nil
	end
end)

selectTab("Credits")
